<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="Examples">

    <process id="helloProcess" name="Hello Process" isExecutable="true">
        <startEvent id="start"/>
        <sequenceFlow id="flow1" sourceRef="start" targetRef="helloTask"/>
        <serviceTask id="helloTask" name="Hello Task"
                     flowable:delegateExpression="${helloDelegate}"/>
        <sequenceFlow id="flow2" sourceRef="helloTask" targetRef="end"/>
        <endEvent id="end"/>
    </process>

</definitions>
